# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Optional: register commands instantly to one server instead of globally
GUILD_ID=

# Channel where /vouch embeds are posted
VOUCH_CHANNEL_ID=1550871579087609886

# Channel where every message gets an auto ✅ reaction
AUTO_REACT_CHANNEL_ID=1550871609588457544
AUTO_REACT_EMOJI=✅

# Role pinged during the /payment flow (Stripe/Giftcard requests, "I've Paid")
PAYMENT_PING_ROLE_ID=1550868852911644794

# Roles that get a user kicked if they ping them (comma-separated)
PROTECTED_ROLE_IDS=1550868852911644794,1550868762176004099

# Optional: shown when a user picks Cashapp
CASHAPP_TAG=$yourcashtag

# Verification
VERIFIED_ROLE_ID=
UNVERIFIED_ROLE_ID=
VERIFY_CHANNEL_ID=

# Optional
EMBED_COLOR=2b2d31
PORT=3000
