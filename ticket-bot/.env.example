# Token of the TICKET bot (a separate Discord application from the Vexel Store bot)
TICKET_BOT_TOKEN=your_ticket_bot_token_here

# Optional: register commands instantly to one server instead of globally
GUILD_ID=

# Role pinged and given access when a ticket is opened
SUPPORT_ROLE_ID=

# Category where ticket channels are created (optional)
TICKET_CATEGORY_ID=

# Channel that receives the "Ticket Closed" embed + HTML transcript
TICKET_LOG_CHANNEL_ID=

# Optional: channel where the panel is auto-posted on startup (or use /ticketpanel)
PANEL_CHANNEL_ID=

# Optional: shown as an "Automated Purchasing" link on the panel
WEBSITE_URL=
STRIPE_SECRET_KEY=

# Optional
BRAND_NAME=Botivo
EMBED_COLOR=1e90ff
PORT=3000
# Stripe webhook signing secret for order logging (endpoint: https://<bot-host>/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Channel that receives order embeds
ORDER_CHANNEL_ID=1551324617896099980
